%!PS
% Make the PDF: gswin64c -dBATCH -dNOPAUSE -dQUIET -dSAFER -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -sOutputFile=scanned_only.pdf scanned_only.ps
% Two pages that are only pictures (like a scan): no text layer at all.
/Pic { gsave 72 72 translate 468 648 scale 8 8 8 [8 0 0 -8 0 8]
  { <0010203040506070 1121314151617181 2232425262728292 33435363738393a3
     44546474849494a4 5565758595a5b5c5 6676869686a6b6c6 77879797a7b7c7d7> }
  image grestore } def
Pic showpage
Pic showpage
