%!PS
% Make the PDF: gswin64c -dBATCH -dNOPAUSE -dQUIET -dSAFER -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -sOutputFile=text_and_scan.pdf text_and_scan.ps
% Page 1: text, then a picture, then more text (the text after the picture must still be read).
% Page 2: a picture only (a scanned page with no text layer).
/Helvetica findfont 12 scalefont setfont
/Pic { gsave 72 72 translate 200 200 scale 8 8 8 [8 0 0 -8 0 8]
  { <0010203040506070 1121314151617181 2232425262728292 33435363738393a3
     44546474849494a4 5565758595a5b5c5 6676869686a6b6c6 77879797a7b7c7d7> }
  image grestore } def
72 700 moveto (Text before the figure on page one.) show
Pic
72 300 moveto (Text after the figure on page one.) show
showpage
gsave 72 72 translate 468 648 scale 8 8 8 [8 0 0 -8 0 8]
  { <0010203040506070 1121314151617181 2232425262728292 33435363738393a3
     44546474849494a4 5565758595a5b5c5 6676869686a6b6c6 77879797a7b7c7d7> }
  image grestore
showpage
